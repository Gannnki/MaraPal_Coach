OPENAI_API_KEY=replace-with-your-api-key

# Docker Compose / Kestra metadata database
KESTRA_DB_USER=kestra
KESTRA_DB_PASSWORD=replace-with-a-long-random-password
KESTRA_DB_NAME=kestra

# Base64-encoded OpenAI key exposed to Kestra as secret('OPENAI_API_KEY').
KESTRA_SECRET_OPENAI_API_KEY=replace-with-base64-encoded-key

MARAPAL_CHAT_MODEL=gpt-4.1-mini
MARAPAL_EMBEDDING_MODEL=text-embedding-3-small
MARAPAL_CHROMA_PATH=data/vector/chroma
MARAPAL_RACE_DB=data/processed/races.sqlite3
MARAPAL_MONITORING_DB=data/processed/monitoring.sqlite3
MARAPAL_RETRIEVAL_MODE=vector
MARAPAL_KNOWLEDGE_PATH=data/processed/knowledge.jsonl
MARAPAL_API_URL=http://localhost:8000
MARAPAL_JUDGE_MODEL=gemini-3.6-flash
GOOGLE_API_KEY=

# LangSmith is opt-in. Set all three to send LangChain/LangGraph traces.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=replace-with-your-api-key
LANGSMITH_PROJECT=marapal
